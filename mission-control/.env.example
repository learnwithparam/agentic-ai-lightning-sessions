# Copy to .env and fill in. `make slack` loads it inside its own process; never paste these on a command line.
# An OpenRouter key; or set OPENAI_API_KEY instead and a WORKFORCE_MODEL OpenAI serves
OPENROUTER_API_KEY=
WORKFORCE_MODEL=nvidia/nemotron-3.5-lightning
# A Slack app with Socket Mode on and the scopes app_mentions:read, channels:history, chat:write
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: search a real repository instead of the fixtures, as owner/name. A token lifts the rate limit.
GITHUB_REPO=
GITHUB_TOKEN=
# Optional: a folder of markdown docs to search instead of fixtures/acme/docs
DOCS_DIR=
# Groups that may read the live GitHub repo, comma separated. With DOCS_DIR, put an access.json beside
# the docs mapping each file name to its groups; a doc missing from it is visible to no one.
GITHUB_ACCESS=engineering
# Mission Control (make demo): your model's list price in USD per million tokens, for cost per outcome
WORKFORCE_PRICE_IN=0.07
WORKFORCE_PRICE_OUT=0.20
# A bot from @BotFather and the chat it asks in. Without them, make demo asks for approval in the terminal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The deploy step: `STACK=1 make demo` sets the stack's local addresses and keys from compose.yaml.
# Set these here only for a stack somewhere else. MISSION_USER signs the board in as that Keycloak user.
KEYCLOAK_URL=
OPENFGA_URL=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MISSION_USER=
